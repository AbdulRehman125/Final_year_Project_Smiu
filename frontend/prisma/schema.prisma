generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          String?
  sessions      Session[]
  accounts      Account[]
  readingAttempts ReadingAttempt[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}


model WritingTask1Image {
  id          String   @id @default(cuid())
  chartType   String   // bar_chart | line_graph | pie_chart | table | process_diagram | map
  imageUrl    String   // stored image URL
  title       String   // "Household energy consumption 1990-2020"
  dataPoints  String   // JSON string — actual data for LLM to use
  difficulty  String   @default("medium") // easy | medium | hard
  createdAt   DateTime @default(now())
}

model ReadingTest {
  id             String   @id @default(cuid())
  title          String
  difficulty     String   @default("mixed")
  passages       Json
  questions      Json
  topics         String[]
  totalQuestions Int      @default(40)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attempts       ReadingAttempt[]

  @@map("reading_test")
}

model ReadingAttempt {
  id                 String      @id @default(cuid())
  userId             String?
  user               User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId             String
  test               ReadingTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  answers            Json
  score              Int
  bandScore          Float
  accuracy           Float
  timeTakenSeconds   Int
  passageScores      Json
  questionTypeScores Json
  timePerPassage     Json?
  recommendations    String[]
  reportSentAt       DateTime?

  startedAt          DateTime    @default(now())
  completedAt        DateTime    @default(now())
  createdAt          DateTime    @default(now())

  @@map("reading_attempt")
}